# Server
PORT=5000
NODE_ENV=development

# MySQL — Local instance MySQL80 (Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=beverage_vault

# Auth (API tokens)
JWT_SECRET=change-me-before-production

# Frontend origin (CORS) — comma-separated allowed origins
# Production example:
# CORS_ORIGIN=https://beveragevaults.com,https://www.beveragevaults.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Public site URL used in password-reset emails (production: https://beveragevaults.com)
FRONTEND_URL=http://localhost:3000

# Gmail SMTP — use an App Password from Google Account → Security
SMTP_USER=beverageacademy63@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=beverageacademy63@gmail.com
